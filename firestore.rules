rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // No enumeration of users
      allow create: if isOwner(userId) 
        && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(userId) 
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isOwner(userId);
    }

    // Freelancer Profiles
    match /freelancerProfiles/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // No enumeration of freelancer profiles
      allow create: if isOwner(userId) 
        && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(userId) 
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isOwner(userId);
    }

    // Leads (Read-only for signed-in users)
    match /leads/{leadId} {
      allow get, list: if isSignedIn();
      allow write: if false;
    }

    // Saved Leads (Private per user)
    match /savedLeads/{savedLeadId} {
      allow get: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() 
        && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() 
        && resource.data.uid == request.auth.uid 
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Jobs (Read-only for signed-in users)
    match /jobs/{jobId} {
      allow get, list: if isSignedIn();
      allow write: if false;
    }

    // Saved Jobs (Private per user)
    match /savedJobs/{savedJobId} {
      allow get: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() 
        && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() 
        && resource.data.uid == request.auth.uid 
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Search History (Private per user)
    match /searches/{searchId} {
      allow get: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow list: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() 
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
  }
}
